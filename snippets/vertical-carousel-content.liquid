<div class="swiper-slide-content__overlay" style="background: {{ overlay_color }};opacity: .{{ opacity }};"></div>
<div class="swiper-slide-content__cont">
  <div class="page-width">
    <div class="swiper-slide-content__cont__title" data-swiper-parallaxNOO="-100">
      {{ title }}
    </div>
    <div class="swiper-slide-content__cont__description" data-swiper-parallaxNOO="-300">
      {{ description }}
    </div>
    <div class="wrapper-button">
      <a class="swiper-slide-content__cont__button" href="{{ link }}" data-swiper-parallaxNOO="-500">
        {{ button_text }}
      </a>
    </div>
  </div>
</div>